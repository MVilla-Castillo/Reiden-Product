# ==========================================
# CCRM-SAAS — Environment Variables (Local Dev)
# ==========================================
# Copia este archivo a .env y completa los valores.
# En producción, estos valores vienen de GCP Secret Manager.
# ==========================================

# Django Core
SECRET_KEY=generate-a-long-random-key-here
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (origins del frontend Angular)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# PostgreSQL
DATABASE_URL=postgres://ccrm_user:ccrm_password@db:5432/ccrm
CONN_MAX_AGE=60
DATABASE_SSL_CA=

# GCP Cloud Tasks
GCP_PROJECT_ID=ccrm-saas-dev
GCP_LOCATION=us-central1
GCP_QUEUE_NAME=ccrm-webhook-tasks
GCP_OIDC_SERVICE_ACCOUNT_EMAIL=cloud-tasks-invoker@ccrm-saas-dev.iam.gserviceaccount.com
WORKER_BASE_URL=https://api.ccrm.example.com
CLOUD_TASKS_INTERNAL_SECRET=change-me-to-a-strong-random-secret-in-production

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_CONTENT_SIDS={}

# PII Encryption (Fernet AES-128)
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WA_ID_ENCRYPTION_KEY=generate-a-fernet-key-here

# Tenant Phone Number ID (WhatsApp Business API)
TENANT_PHONE_NUMBER_ID=

# OIDC Google Workspace
OIDC_GOOGLE_ISSUER=https://accounts.google.com
OIDC_GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
OIDC_GOOGLE_AUDIENCE=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Sentry (Error Tracking)
SENTRY_DSN=
