# ==========================================
# CCRM-SAAS — Environment Variables (Local Dev)
# ==========================================
# Copia este archivo a .env y completa los valores.
# En producción, estos valores vienen de Railway Variables.
# ==========================================

# Entorno de ejecución. Si vale "production", entrypoint.sh aborta cuando DEBUG=true.
ENVIRONMENT=development

# Si "true", entrypoint.sh corre `manage.py migrate` en cada arranque del container.
# En prod (Railway), setear "false" y correr migraciones como release-job aparte
# para evitar que múltiples réplicas migren simultáneamente.
RUN_MIGRATIONS_ON_BOOT=true

# Django Core
SECRET_KEY=generate-a-long-random-key-here
# Cambiar a true SOLO en desarrollo local. En producción debe ser false.
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (origins del frontend Angular)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# CSRF (orígenes confiables para formularios; en prod debe coincidir con el dominio del frontend)
CSRF_TRUSTED_ORIGINS=http://localhost:4200

# PostgreSQL (Railway)
DATABASE_URL=postgres://ccrm_user:ccrm_password@db:5432/ccrm
CONN_MAX_AGE=60
DATABASE_SSL_CA=

# Railway Worker Configuration
WORKER_BASE_URL=https://api.ccrm.example.com

# Internal secret for worker + schedulers (no default — required in production)
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_SECRET=changeme

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_CONTENT_SIDS={}

# PII Encryption (Fernet AES-128)
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WA_ID_ENCRYPTION_KEY=generate-a-fernet-key-here

# Tenant Phone Number ID (WhatsApp Business API)
TENANT_PHONE_NUMBER_ID=

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Sentry (Error Tracking)
SENTRY_DSN=
# Sampling para traces y profiles. En prod default 0.1; subir solo para debugging dirigido.
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Backups (PostgreSQL)
# Directorio local donde el sidecar `backup` escribe los dumps (compose monta volumen aquí).
BACKUP_DIR=/var/backups/ccrm
# Días a retener dumps locales antes de borrarlos.
BACKUP_RETENTION_DAYS=14
# Bucket GCS para upload remoto. Vacío = solo local. Requiere gsutil (hallazgo aparte).
GCS_BACKUP_BUCKET=
