# ==========================================
# CCRM-SAAS — Environment Variables (Local Dev)
# ==========================================
# Copia este archivo a .env y completa los valores.
# En producción, estos valores vienen de Railway Variables.
# ==========================================

# Django Core
SECRET_KEY=generate-a-long-random-key-here
DEBUG=false  # Cambiar a true solo en desarrollo local
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (origins del frontend Angular)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# PostgreSQL (Railway)
DATABASE_URL=postgres://ccrm_user:ccrm_password@db:5432/ccrm
CONN_MAX_AGE=60
DATABASE_SSL_CA=

# Railway Worker Configuration
WORKER_BASE_URL=https://api.ccrm.example.com

# Internal secret for worker + schedulers (no default — required in production)
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_SECRET=changeme

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_CONTENT_SIDS={}

# PII Encryption (Fernet AES-128)
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WA_ID_ENCRYPTION_KEY=generate-a-fernet-key-here

# Tenant Phone Number ID (WhatsApp Business API)
TENANT_PHONE_NUMBER_ID=

# OIDC Google Workspace
OIDC_GOOGLE_ISSUER=https://accounts.google.com
OIDC_GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
OIDC_GOOGLE_AUDIENCE=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Sentry (Error Tracking)
SENTRY_DSN=
