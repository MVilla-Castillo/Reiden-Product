# Django Core Settings
DEBUG=True
SECRET_KEY=django-insecure-local-dev-key
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Settings
DATABASE_URL=postgres://ccrm_user:ccrm_password@db:5432/ccrm


# Twilio (Sprint 3 - Webhook Ingestion)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# GCP Cloud Tasks (Sprint 3 - Async Enqueuing)
GCP_PROJECT_ID=ccrm-saas-dev
GCP_LOCATION=us-central1
GCP_QUEUE_NAME=ccrm-webhook-tasks
GCP_OIDC_SERVICE_ACCOUNT_EMAIL=cloud-tasks-invoker@ccrm-saas-dev.iam.gserviceaccount.com
WORKER_BASE_URL=https://api.ccrm.example.com

# Internal Security (Cloud Tasks → Worker authentication)
CLOUD_TASKS_INTERNAL_SECRET=change-me-to-a-strong-random-secret-in-production

# Google OIDC (Stateless Auth)
OIDC_GOOGLE_ISSUER=https://accounts.google.com
OIDC_GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
OIDC_GOOGLE_AUDIENCE=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
